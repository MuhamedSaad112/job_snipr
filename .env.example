# ══════════════════════════════════════════════════════════════════
#  JobSnipr — Environment Configuration
#  Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════

# --- Required ---
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere
PERSONAL_CHAT_ID=123456789
GROUP_CHAT_ID=-1001234567890

# --- Optional identity ---
SERVICE_NAME=jobsnipr

# --- Optional source API keys (sources skip themselves if unset) ---
ADZUNA_APP_ID=
ADZUNA_API_KEY=
JSEARCH_KEY=

# --- Timing ---
GROUP_DELAY_MINUTES=30
POLL_INTERVAL_SECONDS=300
SCHEDULER_TICK_SECONDS=30
TELEGRAM_SEND_DELAY_SECONDS=1.5

# --- Relevance ---
# Minimum DOMAIN_SCORE (0-100) required in addition to passing the
# acceptance rules (A/B/C/D) before a job is even considered.
MIN_DOMAIN_SCORE=45

# --- Storage ---
DATABASE_PATH=jobsnipr.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=jobsnipr.log

# --- HTTP ---
HTTP_CONNECT_TIMEOUT=6
HTTP_READ_TIMEOUT=20
HTTP_MAX_RETRIES=3
